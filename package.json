{
  "name": "aquaguard",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "format": "prettier \"Frontend/src/**/*.{js,jsx,css}\" \"Frontend/index.html\" \"Frontend/package.json\" \"Backend-JavaScript/**/*.{js,jsx,css,json,md}\" \"AI-Worker/**/*.{js,json,jsonc,md}\" \"package.json\" --write",
    "install:all": "npm install && npm --prefix Frontend install && npm --prefix Backend-JavaScript install && npm --prefix AI-Worker install"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
