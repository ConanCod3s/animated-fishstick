{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aquaguard-ai-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "ai": {
    "binding": "AI",
  },
  "analytics_engine_datasets": [
    {
      "binding": "AI_USAGE",
      "dataset": "aquaguard_ai_usage",
    },
  ],
}
